# Nginx конфигурация для развертывания без Docker
# Для использования: скопируйте в /etc/nginx/sites-available/kontrast-shop
# и создайте симлинк: ln -s /etc/nginx/sites-available/kontrast-shop /etc/nginx/sites-enabled/

# Upstream серверы (локальные процессы вместо Docker контейнеров)
upstream backend_server {
    server 127.0.0.1:8000;
}

upstream frontend_server {
    server 127.0.0.1:3000;
}

# Перенаправление www → без www (HTTP и HTTPS)
server {
    listen 80;
    listen 443 ssl http2;
    server_name www.kontrast-shop.ru;

    ssl_certificate /etc/letsencrypt/live/kontrast-shop.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kontrast-shop.ru/privkey.pem;

    # SSL настройки
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    return 301 https://kontrast-shop.ru$request_uri;
}

# Перенаправление HTTP → HTTPS (для kontrast-shop.ru)
server {
    listen 80;
    server_name kontrast-shop.ru;

    return 301 https://$host$request_uri;
}

# Основной сервер (работает только по HTTPS)
server {
    listen 443 ssl http2;
    server_name kontrast-shop.ru;

    # SSL сертификаты Let's Encrypt
    ssl_certificate /etc/letsencrypt/live/kontrast-shop.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kontrast-shop.ru/privkey.pem;

    # SSL настройки
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Лимиты и таймауты
    client_max_body_size 10M;
    client_body_timeout 60s;
    client_header_timeout 60s;

    # Логи
    access_log /var/log/nginx/kontrast-shop-access.log;
    error_log /var/log/nginx/kontrast-shop-error.log;

    # Статические файлы Django (CSS, JS админки)
    location /staticfiles/ {
        alias /opt/kontrast-shop/back/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Медиа файлы (загруженные изображения товаров)
    location /media/ {
        alias /opt/kontrast-shop/back/media/;
        expires 30d;
        add_header Cache-Control "public";
    }

    # Swagger документация API (только для админов)
    location /swagger {
        proxy_pass http://backend_server;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cookie_path / /;
    }

    # OpenAPI схема
    location /schema {
        proxy_pass http://backend_server;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cookie_path / /;
    }

    # Django Admin панель
    location /admin {
        proxy_pass http://backend_server;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cookie_path / /;
    }

    # REST API
    location /api {
        proxy_pass http://backend_server;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cookie_path / /;
        proxy_redirect off;
    }

    # Next.js frontend (все остальные запросы)
    location / {
        proxy_pass http://frontend_server;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
